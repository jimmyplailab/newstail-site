---
/**
 * Riktig enhetsram runt en skärmdump (Joel 2026-10-04): iPhone 14 Pro eller MacBook Pro,
 * ritade i CSS från devices.css (MIT, src/styles/devices.css). Ramarna är fasta i pixlar
 * (428×868 / 740×434) och skalas till omslagets bredd via --s (sätts i Base.astro).
 */
interface Props {
  kind: "iphone" | "macbook";
  src: string;
  alt: string;
  width: number;
  height: number;
  class?: string;
  style?: string;
}
const { kind, src, alt, width, height, class: cls = "", style } = Astro.props;
const dims = kind === "iphone" ? { w: 428, h: 868 } : { w: 740, h: 434 };
---

<div class={`dev dev-${kind} ${cls}`} style={`--w: ${dims.w}; --h: ${dims.h};${style ? " " + style : ""}`}>
  {
    kind === "iphone" ? (
      <div class="device device-iphone-14-pro device-black">
        <div class="device-frame">
          <div class="device-screen">
            <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="device-stripe" />
        <div class="device-header" />
        <div class="device-sensors" />
        <div class="device-btns" />
        <div class="device-power" />
      </div>
    ) : (
      <div class="device device-macbook-pro device-spacegray">
        <div class="device-frame">
          <div class="device-screen">
            <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
          </div>
        </div>
        <div class="device-header" />
        <div class="device-power" />
      </div>
    )
  }
</div>
