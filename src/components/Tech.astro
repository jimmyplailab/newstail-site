---
/** Tekniken: ingen upprepning av startsidan och inget klot – röstvåg, morgonens tidslinje,
 *  stora siffror, ikoner och teknikvalen. */
import type { TechPage } from "../i18n/subpages";
import { START_URL } from "../i18n/types";

interface Props {
  page: TechPage;
  cta: string;
}
const { page, cta } = Astro.props;
const BARS = 56;
const icons: Record<string, string> = {
  bell: '<path d="M6 16V11a6 6 0 1 1 12 0v5l1.5 2h-15z"/><path d="M10 20.5a2 2 0 0 0 4 0"/>',
  lock: '<rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/>',
  head: '<path d="M4 15v-2a8 8 0 0 1 16 0v2"/><rect x="3.5" y="14" width="4" height="6.5" rx="1.5"/><rect x="16.5" y="14" width="4" height="6.5" rx="1.5"/>',
  wave: '<path d="M4 12h1.5M7.5 9v6M11 6v12M14.5 8.5v7M18 10.5v3M20 12h0"/>',
  grid: '<rect x="4" y="4" width="7" height="7" rx="2"/><rect x="13" y="4" width="7" height="7" rx="2"/><rect x="4" y="13" width="16" height="7" rx="2"/>',
  car: '<path d="M5 16.5v-4l2-5h10l2 5v4"/><path d="M4 16.5h16v2.5H4z"/><circle cx="8" cy="16.5" r="0.5"/><circle cx="16" cy="16.5" r="0.5"/>',
};
---

<section class="sub-hero" data-space data-hue="200" data-watch>
  <div class="sub-hero-inner">
    <h1 class="title-hero">{page.title}</h1>
    <p class="lead">{page.lead}</p>
  </div>
  <div class="voicewave" aria-hidden="true">
    {Array.from({ length: BARS }, (_, i) => <span style={`--i: ${i}; --h: ${0.25 + 0.75 * Math.abs(Math.sin(i * 0.53) * Math.cos(i * 0.21))}`} />)}
  </div>
</section>

<section class="sub-section morning" id="morgon" data-space data-hue="200" data-watch>
  <div class="morning-grid">
    <div class="morning-side">
      <h2 class="title-xl">{page.morning.title}</h2>
      <p class="lead">{page.morning.lead}</p>
      <div class="morning-rail" aria-hidden="true"><span></span></div>
    </div>
    <ol class="morning-steps">
      {
        page.morning.steps.map((s, i) => (
          <li class="morning-step" data-step={i}>
            <span class="morning-n">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="sub-section" id="personligt" data-space data-hue="150" data-watch>
  <div class="sub-head">
    <h2 class="title-xl">{page.personal.title}</h2>
    <p class="lead">{page.personal.lead}</p>
  </div>
  <ul class="bignums">
    {
      page.personal.items.map((it, i) => (
        <li class="reveal" style={`--i: ${i}`}>
          <span class="bignum">{it.big}</span>
          <strong>{it.t}</strong>
          <p>{it.d}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="sub-section" id="iphone" data-space data-hue="230" data-watch>
  <div class="sub-head">
    <h2 class="title-xl">{page.ios.title}</h2>
    <p class="lead">{page.ios.lead}</p>
  </div>
  <ul class="icon-grid">
    {
      page.ios.items.map((it, i) => (
        <li class="reveal" style={`--i: ${i}`}>
          <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[it.icon]} />
          <strong>{it.t}</strong>
          <p>{it.d}</p>
        </li>
      ))
    }
  </ul>
</section>

<section class="sub-section" id="teknik" data-space data-hue="262" data-watch>
  <div class="stack-grid">
    <div class="sub-head">
      <h2 class="title-xl">{page.stack.title}</h2>
      <p class="lead">{page.stack.lead}</p>
    </div>
    <dl class="spec">
      {
        page.stack.rows.map((r, i) => (
          <div class="reveal" style={`--i: ${i}`}>
            <dt>{r.k}</dt>
            <dd>{r.v}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<section class="sub-cta" data-space data-hue="262" data-watch>
  <h2 class="title-xl">{page.cta.title}</h2>
  <p class="lead">{page.cta.lead}</p>
  <div class="actions">
    <a class="pill pill-primary pill-lg" href={START_URL}>{cta}</a>
  </div>
</section>

<script>
  // Tidslinjen: rälsen fylls när man scrollar, steget mitt i vyn tänds.
  const grid = document.querySelector<HTMLElement>(".morning-grid");
  const steps = [...document.querySelectorAll<HTMLElement>(".morning-step")];
  if (grid && steps.length) {
    const onScroll = () => {
      const r = grid.getBoundingClientRect();
      const mid = innerHeight * 0.55;
      const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      grid.style.setProperty("--p", p.toFixed(3));
      let active = 0;
      steps.forEach((s, i) => {
        if (s.getBoundingClientRect().top < mid) active = i;
      });
      steps.forEach((s, i) => s.classList.toggle("is-on", i === active));
    };
    onScroll();
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);
  }
</script>
