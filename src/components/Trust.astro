---
/** Trygghet: vad ledningen ser (prickar som aggregat) och hur data skyddas. Inget klot,
 *  inga leverantörsnamn eller lagringstider (Joel 2026-09-30). */
import type { TrustPage } from "../i18n/subpages";
import LineArt from "./LineArt.astro";

interface Props {
  page: TrustPage;
}
const { page } = Astro.props;
const RING = 12;
const DOTS = 41;
const LIT = 34;
// Samma prickmönster varje gång: vilka som lyser är utspritt, inte i ordning – ingen enskild pekas ut.
const lit = new Set<number>();
let seed = 7;
while (lit.size < LIT) {
  seed = (seed * 16807) % 2147483647;
  lit.add(seed % DOTS);
}
---

<section class="sub-hero sub-hero-split" data-space data-hue="230" data-watch>
  <div class="sub-hero-inner">
    <h1 class="title-hero">{page.title}</h1>
    <p class="lead">{page.lead}</p>
  </div>
  <div class="shield" aria-hidden="true">
    <div class="shield-ring"></div>
    <div class="shield-core">
      <svg viewBox="0 0 48 48" width="64" height="64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path class="shield-lock" pathLength="1" d="M15 21h18a3 3 0 0 1 3 3v12a3 3 0 0 1-3 3H15a3 3 0 0 1-3-3V24a3 3 0 0 1 3-3z" />
        <path class="shield-shackle" pathLength="1" d="M17 21v-5a7 7 0 0 1 14 0v5" />
        <circle class="shield-dot" cx="24" cy="30" r="1.6" />
      </svg>
    </div>
    <div class="shield-people">
      {Array.from({ length: RING }, (_, i) => <span style={`--a: ${(360 / RING) * i}deg; --i: ${i}`} />)}
    </div>
  </div>
</section>

<section class="sub-section" id="ser" data-space data-hue="230" data-watch>
  <div class="sees-grid">
    <div class="sub-head">
      <h2 class="title-xl">{page.sees.title}</h2>
      <p class="lead">{page.sees.lead}</p>
      <div class="dots" aria-hidden="true">
        {Array.from({ length: DOTS }, (_, i) => <span class={lit.has(i) ? "on" : ""} style={`--i: ${i}`} />)}
      </div>
      <p class="dots-caption">34 av 41</p>
    </div>
    <div class="sees-lists">
      <div>
        <h3>{page.sees.yesLabel}</h3>
        <ul class="check-list">
          {page.sees.yes.map((x, i) => <li class="reveal" style={`--i: ${i}`}>{x}</li>)}
        </ul>
      </div>
      <div class="sees-no">
        <h3>{page.sees.noLabel}</h3>
        <ul class="cross-list">
          {page.sees.no.map((x, i) => <li class="reveal" style={`--i: ${i + 2}`}>{x}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="sub-section" id="skydd" data-space data-hue="262" data-watch>
  <div class="protect-grid">
  <div class="protect-side">
    <h2 class="title-xl">{page.protect.title}</h2>
    <LineArt kind="cones" />
  </div>
  <ul class="quiet-grid quiet-grid-4">
    {
      page.protect.items.map((it, i) => (
        <li class="reveal" style={`--i: ${i}`}>
          <strong>{it.t}</strong>
          <p>{it.d}</p>
        </li>
      ))
    }
  </ul>
  </div>
</section>

