---
import type { Copy } from "../i18n/types";
import { START_URL } from "../i18n/types";

interface Props {
  copy: Copy;
}
const { copy: c } = Astro.props;
const words = (s: string) => s.split(" ");
const pricing = c.lang === "sv" ? "/pris/" : "/en/pricing/";
/** Klotet vilar (tonar bort) i sektioner med skärmar eller bara text. */
const REST = "0.5,0.5,0.1,0";
---

<!-- 1. Hero: löftet, ljudprovet och värdet för bolaget -->
<section class="section hero" data-space data-hue="262" data-watch>
  <div class="split">
    <div class="split-text stack">
      <h1 class="title-hero">{c.hero.title}</h1>
      <p class="lead">{c.hero.lead}</p>
      <div class="actions">
        <a class="pill pill-primary pill-lg" href={START_URL}>{c.hero.cta}</a>
        <button class="pill pill-secondary pill-lg play-sample" type="button" data-src={`/audio/sample-${c.lang}.mp3`} data-label={c.hero.listen} data-playing={c.hero.listening} aria-pressed="false">
          <span class="play-icon" aria-hidden="true"></span><span class="play-label">{c.hero.listen}</span>
        </button>
      </div>
    </div>
    <div class="split-stage stage-hero">
      <div class="orb-anchor" data-orb-anchor></div>
      <div class="bubbles" style="--wait: 1700ms">
        <span class="bubble bubble-r b-hero-1" style="--i: 0">{c.hero.bubbles[0]}</span>
        <span class="bubble bubble-l b-hero-2" style="--i: 1">{c.hero.bubbles[1]}</span>
        <span class="bubble bubble-r bubble-inside b-hero-3" style="--i: 2">{c.hero.bubbles[2]}</span>
      </div>
    </div>
  </div>
  <ul class="hero-values" id="foretag">
    {
      c.value.rows.map((r, i) => (
        <li class="reveal" style={`--i: ${i + 3}`}>
          <strong>{r.title}</strong> <span>{r.text}</span>
        </li>
      ))
    }
  </ul>
</section>

<!-- 2. Språket: USP – alla med, på sitt eget språk -->
<section class="section" id="sprak" data-space data-hue="262" data-watch>
  <div class="split orb-left">
    <div class="split-text stack">
      <h2 class="title-xl">{c.language.title}</h2>
      <p class="lead">{c.language.lead}</p>
    </div>
    <div class="split-stage stage-language">
      <div class="orb-anchor" data-orb-anchor></div>
      <div class="lang-chips" aria-hidden="true">
        {c.language.samples.map((x, i) => (
          <span class={`lang-chip lang-chip-${i}${i === 0 ? " is-on" : ""}`} data-i={i}>{x.code}</span>
        ))}
      </div>
      <div class="caption caption-language" style="--wait: 300ms" aria-live="off">
        <span class="caption-topic" data-lang-topic>{c.language.samples[0]!.topic}</span>
        <span class="caption-title" data-lang-title>
          {words(c.language.samples[0]!.title).map((w, i) => (
            <><span class="caption-word" style={`--i: ${i}`}>{w}</span>{" "}</>
          ))}
        </span>
      </div>
      <script type="application/json" data-lang-samples set:html={JSON.stringify(c.language.samples)} />
    </div>
  </div>
</section>

<!-- 3. Sändningen: appen -->
<section class="section" id="sandningen" data-space data-hue="200" data-orb={REST} data-watch>
  <div class="split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.broadcast.title}</h2>
      <p class="lead">{c.broadcast.lead}</p>
      <ul class="deep-points">
        {c.broadcast.points.map((p, i) => (
          <li class="reveal" style={`--i: ${i + 1}`}>
            <strong>{p.t}</strong>
            <span>{p.d}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="split-stage phone-stage reveal" style="--i: 1">
      <div class="phone">
        <img src="/screens/app-home.webp" alt={c.lang === "sv" ? "Newstail-appens hemvy med dagens rubriker" : "The Newstail app home screen with today's headlines"} width="720" height="1565" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

<!-- 4. Inside: bolagets röst -->
<section class="section" id="inside" data-space data-hue="72" data-orb={REST} data-watch>
  <div class="split orb-left">
    <div class="split-text stack">
      <h2 class="title-xl">{c.inside.title}</h2>
      <p class="lead">{c.inside.lead}</p>
      <ol class="mini-flow" aria-label={c.lang === "sv" ? "Så går det till" : "How it works"}>
        {c.inside.flow.map((f, i) => (
          <li class="reveal" style={`--i: ${i + 1}`}><span>{f}</span></li>
        ))}
      </ol>
      <ul class="deep-points inside-points">
        {c.inside.points.map((p, i) => (
          <li class="reveal" style={`--i: ${i + 3}`}>
            <strong>{p.t}</strong>
            <span>{p.d}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="split-stage phone-stage">
      <div class="phone reveal" style="--i: 0">
        <img src="/screens/app-publish.webp" alt={c.lang === "sv" ? "Publicera i Newstail-appen: tala in ett internt budskap" : "Publishing in the Newstail app: record an internal message"} width="720" height="1565" loading="lazy" decoding="async" />
      </div>
      <div class="bubbles" style="--wait: 500ms">
        <span class="bubble bubble-r bubble-inside b-in-1" style="--i: 0">{c.inside.bubble}</span>
        <span class="bubble bubble-l b-in-2 muted" style="--i: 2">{c.inside.reach}</span>
      </div>
    </div>
  </div>
</section>

<!-- 5. Recap & Quiz -->
<section class="section" id="quiz" data-space data-hue="300" data-watch>
  <div class="split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.quiz.title}</h2>
      <p class="lead">{c.quiz.lead}</p>
    </div>
    <div class="split-stage stage-quiz">
      <div class="orb-anchor" data-orb-anchor></div>
      <div class="pills-row pills-quiz" style="--wait: 500ms">
        <span class="pill pill-recap">{c.quiz.recap.toUpperCase()}</span>
        <span class="pill pill-quiz">{c.quiz.quiz.toUpperCase()}</span>
      </div>
    </div>
  </div>
</section>

<!-- 6. För ledningen -->
<section class="section" id="ledare" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.leaders.title}</h2>
      <p class="lead">{c.leaders.lead}</p>
      <div class="stats">
        {
          c.leaders.stats.map((s, i) => (
            <div class="stat reveal" style={`--i: ${i + 1}`}>
              <span class="stat-value">{s.value}</span>
              <span class="stat-label">{s.label}</span>
            </div>
          ))
        }
      </div>
      <p class="subtle stats-note">{c.leaders.statsNote}</p>
    </div>
    <div class="split-stage stage-admin reveal" style="--i: 2">
      <div class="screen screen-admin">
        <img src="/screens/admin-overview.webp" alt={c.lang === "sv" ? "Admin i Newstail: översikt över lyssnande och interna budskap" : "Newstail admin: overview of listening and internal messages"} width="1400" height="1242" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

<!-- 8. Avslut med pris i en mening -->
<section class="section closing" data-space data-hue="262" data-watch>
  <div class="orb-anchor orb-anchor-closing" data-orb-anchor></div>
  <div class="stack closing-text">
    <h2 class="title-xl">{c.closing.title}</h2>
    <p class="lead">{c.closing.lead}</p>
    <div class="actions">
      <a class="pill pill-primary pill-lg" href={START_URL}>{c.closing.cta}</a>
      <a class="pill pill-secondary pill-lg" href={pricing}>{c.closing.priceLink}</a>
    </div>
  </div>
</section>

<script>
  // Språksektionen: samma interna nyhet på värdens fyra språk. Klotet byter ton och lyser upp
  // vid varje byte (Space läser data-hue varje ruta och window.__orbKick).
  const langSec = document.getElementById("sprak");
  const samplesEl = langSec?.querySelector<HTMLScriptElement>("[data-lang-samples]");
  if (langSec && samplesEl) {
    const samples = JSON.parse(samplesEl.textContent || "[]") as { code: string; topic: string; title: string }[];
    const HUES = [262, 200, 30, 330];
    const topic = langSec.querySelector<HTMLElement>("[data-lang-topic]")!;
    const title = langSec.querySelector<HTMLElement>("[data-lang-title]")!;
    const chips = [...langSec.querySelectorAll<HTMLElement>(".lang-chip")];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let i = 0;
    let timer = 0;
    const w = window as unknown as { __orbKick?: number };
    const show = (k: number) => {
      const x = samples[k]!;
      topic.textContent = x.topic;
      title.innerHTML = "";
      x.title.split(" ").forEach((word, j) => {
        const sp = document.createElement("span");
        sp.className = "caption-word";
        sp.style.setProperty("--i", String(j));
        sp.style.setProperty("--wait", "0ms");
        sp.textContent = word;
        title.append(sp, " ");
      });
      chips.forEach((c, j) => c.classList.toggle("is-on", j === k));
      langSec.dataset.hue = String(HUES[k % HUES.length]);
      w.__orbKick = (w.__orbKick ?? 0) + 1;
    };
    const start = () => {
      if (timer || reduced) return;
      timer = window.setInterval(() => {
        i = (i + 1) % samples.length;
        show(i);
      }, 2800);
    };
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    new IntersectionObserver(([e]) => (e!.isIntersecting ? start() : stop()), { threshold: 0.5 }).observe(langSec);
    chips.forEach((c, k) =>
      c.addEventListener("click", () => {
        stop();
        i = k;
        show(k);
        start();
      }),
    );
  }

  // "Så låter det": spelar ljudprovet och skickar röstens styrka till klotet (window.__voiceAmp).
  const btn = document.querySelector<HTMLButtonElement>(".play-sample");
  if (btn) {
    let audio: HTMLAudioElement | null = null;
    let ctx: AudioContext | null = null;
    let analyser: AnalyserNode | null = null;
    let raf = 0;
    const w = window as unknown as { __voiceAmp: number };
    const label = btn.querySelector(".play-label")!;
    const setPlaying = (on: boolean) => {
      btn.setAttribute("aria-pressed", on ? "true" : "false");
      btn.classList.toggle("is-playing", on);
      label.textContent = on ? btn.dataset.playing! : btn.dataset.label!;
      if (!on) {
        cancelAnimationFrame(raf);
        w.__voiceAmp = 0;
      }
    };
    const tick = () => {
      if (!analyser) return;
      const buf = new Uint8Array(analyser.fftSize);
      analyser.getByteTimeDomainData(buf);
      let sum = 0;
      for (let i = 0; i < buf.length; i++) {
        const v = (buf[i]! - 128) / 128;
        sum += v * v;
      }
      w.__voiceAmp = Math.min(1, Math.sqrt(sum / buf.length) * 4);
      raf = requestAnimationFrame(tick);
    };
    btn.addEventListener("click", async () => {
      if (!audio) {
        audio = new Audio(btn.dataset.src!);
        audio.preload = "auto";
        audio.addEventListener("ended", () => setPlaying(false));
        audio.addEventListener("pause", () => setPlaying(false));
        audio.addEventListener("play", () => setPlaying(true));
      }
      if (!audio.paused) {
        audio.pause();
        return;
      }
      try {
        if (!ctx) {
          ctx = new AudioContext();
          const src = ctx.createMediaElementSource(audio);
          analyser = ctx.createAnalyser();
          analyser.fftSize = 512;
          src.connect(analyser);
          analyser.connect(ctx.destination);
        }
        await ctx.resume();
      } catch {
        analyser = null;
      }
      await audio.play();
      if (analyser) tick();
    });
  }
</script>
