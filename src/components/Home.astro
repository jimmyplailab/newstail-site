---
import type { Copy } from "../i18n/types";
import { START_URL } from "../i18n/types";

interface Props {
  copy: Copy;
}
const { copy: c } = Astro.props;
const words = (s: string) => s.split(" ");
const pricing = c.lang === "sv" ? "/pris/" : "/en/pricing/";
/** Klotet vilar (tonar bort) i sektioner med skärmar eller bara text. */
const REST = "0.5,0.5,0.1,0";
---

<!-- 1. Hero: löftet, ljudprovet och värdet för bolaget -->
<section class="section hero" data-space data-hue="262" data-watch>
  <div class="split">
    <div class="split-text stack">
      <h1 class="title-hero">{c.hero.title}</h1>
      <p class="lead">{c.hero.lead}</p>
      <div class="actions">
        <a class="pill pill-primary pill-lg" href={START_URL}>{c.hero.cta}</a>
      </div>
    </div>
    <div class="split-stage stage-hero">
      <div class="orb-anchor" data-orb-anchor></div>
      <!-- Ljudprovet mitt på klotet: klotet lyser med rösten medan det spelar. -->
      <button class="orb-play play-sample" type="button" data-src={`/audio/sample-${c.lang}.mp3`} data-label={c.hero.listen} data-playing={c.hero.listening} aria-pressed="false" aria-label={c.hero.listen}>
        <span class="orb-play-circle"><span class="play-icon" aria-hidden="true"></span></span>
        <span class="play-label">{c.hero.listen}</span>
      </button>
      <!-- Som under sändning i appen: prickarna ovanför klotet, pilarna vid sidorna,
           ämne + rubrik under. Rubrikerna byter som värden berättar dem. -->
      <div class="air-dots" aria-hidden="true">
        {c.hero.items.map((_, i) => <span class={i === 0 ? "is-on" : ""} />)}
      </div>
      <button class="air-arrow air-arrow-prev" type="button" data-step="-1" aria-label={c.lang === "sv" ? "Föregående" : "Previous"}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 6l-6 6 6 6" /><path d="M8 6v12" /></svg>
      </button>
      <button class="air-arrow air-arrow-next" type="button" data-step="1" aria-label={c.lang === "sv" ? "Nästa" : "Next"}>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M10 6l6 6-6 6" /><path d="M16 6v12" /></svg>
      </button>
      <div class="caption caption-hero" style="--wait: 1500ms" aria-live="off">
        <span class="caption-topic" data-hero-topic>{c.hero.items[0]!.topic}</span>
        <span class="caption-title" data-hero-title>
          {words(c.hero.items[0]!.title).map((w, i) => (
            <><span class="caption-word" style={`--i: ${i}`}>{w}</span>{" "}</>
          ))}
        </span>
      </div>
      <script type="application/json" data-hero-items set:html={JSON.stringify(c.hero.items)} />
    </div>
  </div>
</section>

<!-- 2. Språket: USP – alla med, på sitt eget språk -->
<section class="section" id="sprak" data-space data-hue="262" data-watch>
  <div class="split orb-left lang-split">
    <div class="split-text stack">
      <div class="lang-chips" aria-hidden="true">
        {c.language.samples.map((x, i) => (
          <span class={`lang-chip lang-chip-${i}${i === 0 ? " is-on" : ""}`} data-i={i}>{x.code}</span>
        ))}
      </div>
      <h2 class="title-xl">{c.language.title}</h2>
      <p class="lead">{c.language.lead}</p>
    </div>
    <div class="split-stage stage-language">
      <div class="orb-anchor" data-orb-anchor></div>
      <div class="caption caption-language" style="--wait: 300ms" aria-live="off">
        <span class="caption-topic" data-lang-topic>{c.language.samples[0]!.topic}</span>
        <span class="caption-title" data-lang-title>
          {words(c.language.samples[0]!.title).map((w, i) => (
            <><span class="caption-word" style={`--i: ${i}`}>{w}</span>{" "}</>
          ))}
        </span>
      </div>
      <script type="application/json" data-lang-samples set:html={JSON.stringify(c.language.samples)} />
    </div>
  </div>
</section>

<!-- 3. Sändningen: appen -->
<section class="section" id="sandningen" data-space data-hue="200" data-orb={REST} data-watch>
  <div class="split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.broadcast.title}</h2>
      <p class="lead">{c.broadcast.lead}</p>
      <ul class="deep-points">
        {c.broadcast.points.map((p, i) => (
          <li class="reveal" style={`--i: ${i + 1}`}>
            <strong>{p.t}</strong>
            <span>{p.d}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="split-stage phone-stage reveal" style="--i: 1" data-tilt>
      <div class="phone phone-3d phone-tilt-l">
        <img src="/screens/app-home.webp" alt={c.lang === "sv" ? "Newstail-appens hemvy med dagens rubriker" : "The Newstail app home screen with today's headlines"} width="720" height="1565" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

<!-- 4. Inside: bolagets röst -->
<section class="section" id="inside" data-space data-hue="72" data-orb={REST} data-watch>
  <div class="split orb-left">
    <div class="split-text stack">
      <h2 class="title-xl">{c.inside.title}</h2>
      <p class="lead">{c.inside.lead}</p>
      <ol class="mini-flow" aria-label={c.lang === "sv" ? "Så går det till" : "How it works"}>
        {c.inside.flow.map((f, i) => (
          <li class="reveal" style={`--i: ${i + 1}`}><span>{f}</span></li>
        ))}
      </ol>
      <ul class="deep-points inside-points">
        {c.inside.points.map((p, i) => (
          <li class="reveal" style={`--i: ${i + 3}`}>
            <strong>{p.t}</strong>
            <span>{p.d}</span>
          </li>
        ))}
      </ul>
    </div>
    <div class="split-stage phone-stage" data-tilt>
      <div class="phone phone-3d phone-tilt-r reveal" style="--i: 0">
        <img src="/screens/app-publish.webp" alt={c.lang === "sv" ? "Publicera i Newstail-appen: tala in ett internt budskap" : "Publishing in the Newstail app: record an internal message"} width="720" height="1565" loading="lazy" decoding="async" />
      </div>
      <div class="bubbles" style="--wait: 500ms">
        <span class="bubble bubble-r bubble-inside b-in-1" style="--i: 0">{c.inside.bubble}</span>
        <span class="bubble bubble-l b-in-2 muted" style="--i: 2">{c.inside.reach}</span>
      </div>
    </div>
  </div>
</section>

<!-- 5. Recap & Quiz -->
<section class="section" id="quiz" data-space data-hue="300" data-watch>
  <div class="split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.quiz.title}</h2>
      <p class="lead">{c.quiz.lead}</p>
    </div>
    <div class="split-stage stage-quiz">
      <div class="orb-anchor" data-orb-anchor></div>
      <div class="quiz-cluster">
      <div class="quiz-card reveal" style="--i: 1" data-quiz aria-live="off">
        <span class="quiz-kicker">{c.quiz.quiz}</span>
        <p class="quiz-q" data-quiz-q>{c.quiz.questions[0]!.q}</p>
        <ul class="quiz-options" data-quiz-options>
          {c.quiz.questions[0]!.options.map((o) => <li><span class="quiz-dot"></span><span>{o}</span></li>)}
        </ul>
        <p class="quiz-result" data-quiz-result>{c.quiz.result}</p>
      </div>
      <div class="recap-strip reveal" style="--i: 2" aria-hidden="true">
        <span class="recap-label">{c.quiz.recap}</span>
        <span class="recap-chip">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7 0l2-2a5 5 0 0 0-7-7l-1 1" /><path d="M14 11a5 5 0 0 0-7 0l-2 2a5 5 0 0 0 7 7l1-1" /></svg>
          {c.quiz.sources}
        </span>
        <span class="recap-chip">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12" /><path d="M8 7l4-4 4 4" /><path d="M5 12v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7" /></svg>
          {c.quiz.share}
        </span>
      </div>
      </div>
      <script type="application/json" data-quiz-items set:html={JSON.stringify(c.quiz.questions)} />
    </div>
  </div>
</section>

<!-- 6. För ledningen -->
<section class="section" id="ledare" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.leaders.title}</h2>
      <p class="lead">{c.leaders.lead}</p>
      <p class="subtle stats-note">{c.leaders.statsNote}</p>
    </div>
    <div class="split-stage stage-admin" data-tilt>
      <div class="browser browser-3d reveal" style="--i: 1">
        <div class="browser-bar" aria-hidden="true">
          <span></span><span></span><span></span>
          <span class="browser-url">air.newstail.io/admin</span>
        </div>
        <img src="/screens/admin-overview.webp" alt={c.lang === "sv" ? "Admin i Newstail: översikt över lyssnande och interna budskap" : "Newstail admin: overview of listening and internal messages"} width="1400" height="1242" loading="lazy" decoding="async" />
      </div>
      {
        c.leaders.stats.map((s, i) => (
          <div class={`stat-card stat-card-${i} reveal`} style={`--i: ${i + 2}`}>
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<!-- 7. Avslut: inget klot, sidfoten ingår i samma skärm -->
<section class="section closing" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="stack closing-text">
    <h2 class="title-xl">{c.closing.title}</h2>
    <p class="lead">{c.closing.lead}</p>
    <div class="actions">
      <a class="pill pill-primary pill-lg" href={START_URL}>{c.closing.cta}</a>
      <a class="pill pill-secondary pill-lg" href={pricing}>{c.closing.priceLink}</a>
    </div>
  </div>
</section>

<script>
  // Språksektionen: samma interna nyhet på värdens fyra språk. Klotet byter ton och lyser upp
  // vid varje byte (Space läser data-hue varje ruta och window.__orbKick).
  const langSec = document.getElementById("sprak");
  const samplesEl = langSec?.querySelector<HTMLScriptElement>("[data-lang-samples]");
  if (langSec && samplesEl) {
    const samples = JSON.parse(samplesEl.textContent || "[]") as { code: string; topic: string; title: string }[];
    const HUES = [262, 200, 30, 330];
    const topic = langSec.querySelector<HTMLElement>("[data-lang-topic]")!;
    const title = langSec.querySelector<HTMLElement>("[data-lang-title]")!;
    const chips = [...langSec.querySelectorAll<HTMLElement>(".lang-chip")];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let i = 0;
    let timer = 0;
    const w = window as unknown as { __orbKick?: number };
    const show = (k: number) => {
      const x = samples[k]!;
      topic.textContent = x.topic;
      title.innerHTML = "";
      x.title.split(" ").forEach((word, j) => {
        const sp = document.createElement("span");
        sp.className = "caption-word";
        sp.style.setProperty("--i", String(j));
        sp.style.setProperty("--wait", "0ms");
        sp.textContent = word;
        title.append(sp, " ");
      });
      chips.forEach((c, j) => c.classList.toggle("is-on", j === k));
      langSec.dataset.hue = String(HUES[k % HUES.length]);
      w.__orbKick = (w.__orbKick ?? 0) + 1;
    };
    const start = () => {
      if (timer || reduced) return;
      timer = window.setInterval(() => {
        i = (i + 1) % samples.length;
        show(i);
      }, 2800);
    };
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    new IntersectionObserver(([e]) => (e!.isIntersecting ? start() : stop()), { threshold: 0.5 }).observe(langSec);
    chips.forEach((c, k) =>
      c.addEventListener("click", () => {
        stop();
        i = k;
        show(k);
        start();
      }),
    );
  }

  // Heron: rubrikerna byter som värden berättar dem (prickar, ämne + rubrik, klotets ton).
  const hero = document.querySelector<HTMLElement>(".hero");
  const heroItemsEl = hero?.querySelector<HTMLScriptElement>("[data-hero-items]");
  if (hero && heroItemsEl) {
    const items = JSON.parse(heroItemsEl.textContent || "[]") as { topic: string; title: string; inside?: boolean }[];
    const HUES = [262, 72, 200];
    const topic = hero.querySelector<HTMLElement>("[data-hero-topic]")!;
    const title = hero.querySelector<HTMLElement>("[data-hero-title]")!;
    const dots = [...hero.querySelectorAll<HTMLElement>(".air-dots span")];
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const w = window as unknown as { __orbKick?: number };
    let i = 0;
    let timer = 0;
    const show = (k: number) => {
      const x = items[k]!;
      topic.textContent = x.topic;
      title.innerHTML = "";
      x.title.split(" ").forEach((word, j) => {
        const sp = document.createElement("span");
        sp.className = "caption-word";
        sp.style.setProperty("--i", String(j));
        sp.style.setProperty("--wait", "0ms");
        sp.textContent = word;
        title.append(sp, " ");
      });
      dots.forEach((d, j) => d.classList.toggle("is-on", j === k));
      hero.classList.toggle("is-inside", !!x.inside);
      hero.dataset.hue = String(HUES[k % HUES.length]);
      w.__orbKick = (w.__orbKick ?? 0) + 1;
    };
    const start = () => {
      if (timer || reduced) return;
      timer = window.setInterval(() => {
        i = (i + 1) % items.length;
        show(i);
      }, 3400);
    };
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    new IntersectionObserver(([e]) => (e!.isIntersecting ? start() : stop()), { threshold: 0.5 }).observe(hero);
    hero.querySelectorAll<HTMLButtonElement>(".air-arrow").forEach((b) =>
      b.addEventListener("click", () => {
        stop();
        i = (i + Number(b.dataset.step) + items.length) % items.length;
        show(i);
        start();
      }),
    );
  }

  // Quizrutan: värden ställer frågan, svaret väljs, resultatet tonar in – sedan nästa fråga.
  const quiz = document.querySelector<HTMLElement>("[data-quiz]");
  const quizItemsEl = document.querySelector<HTMLScriptElement>("[data-quiz-items]");
  if (quiz && quizItemsEl) {
    const qs = JSON.parse(quizItemsEl.textContent || "[]") as { q: string; options: string[]; answer: number }[];
    const qEl = quiz.querySelector<HTMLElement>("[data-quiz-q]")!;
    const list = quiz.querySelector<HTMLElement>("[data-quiz-options]")!;
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let k = 0;
    let t1 = 0;
    let t2 = 0;
    const render = (n: number) => {
      const q = qs[n]!;
      quiz.classList.remove("is-answered");
      qEl.textContent = q.q;
      list.innerHTML = "";
      q.options.forEach((o, j) => {
        const li = document.createElement("li");
        li.style.setProperty("--i", String(j));
        li.innerHTML = `<span class="quiz-dot"></span><span>${o}</span>`;
        if (j === q.answer) li.dataset.correct = "";
        list.append(li);
      });
      quiz.classList.add("is-fresh");
      requestAnimationFrame(() => quiz.classList.remove("is-fresh"));
    };
    const play = () => {
      render(k);
      if (reduced) {
        quiz.classList.add("is-answered");
        return;
      }
      t1 = window.setTimeout(() => quiz.classList.add("is-answered"), 2200);
      t2 = window.setTimeout(() => {
        k = (k + 1) % qs.length;
        play();
      }, 6200);
    };
    const stop = () => {
      clearTimeout(t1);
      clearTimeout(t2);
    };
    render(0);
    new IntersectionObserver(([e]) => (e!.isIntersecting ? play() : stop()), { threshold: 0.5 }).observe(quiz);
  }

  // Telefonerna och admin-ramen lutar sig svagt mot muspekaren (bara med mus, mjukt utjämnat).
  if (matchMedia("(pointer: fine)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((stage) => {
      let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0;
      const tick = () => {
        cx += (tx - cx) * 0.08;
        cy += (ty - cy) * 0.08;
        stage.style.setProperty("--tilt-x", `${cy.toFixed(2)}deg`);
        stage.style.setProperty("--tilt-y", `${cx.toFixed(2)}deg`);
        if (Math.abs(tx - cx) > 0.01 || Math.abs(ty - cy) > 0.01) raf = requestAnimationFrame(tick);
        else raf = 0;
      };
      const kick = () => { if (!raf) raf = requestAnimationFrame(tick); };
      stage.addEventListener("pointermove", (e) => {
        const r = stage.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width - 0.5) * 10;
        ty = -((e.clientY - r.top) / r.height - 0.5) * 8;
        kick();
      });
      stage.addEventListener("pointerleave", () => { tx = 0; ty = 0; kick(); });
    });
  }

  // "Så låter det": spelar ljudprovet och skickar röstens styrka till klotet (window.__voiceAmp).
  const btn = document.querySelector<HTMLButtonElement>(".play-sample");
  if (btn) {
    let audio: HTMLAudioElement | null = null;
    let ctx: AudioContext | null = null;
    let analyser: AnalyserNode | null = null;
    let raf = 0;
    const w = window as unknown as { __voiceAmp: number };
    const label = btn.querySelector(".play-label")!;
    const setPlaying = (on: boolean) => {
      btn.setAttribute("aria-pressed", on ? "true" : "false");
      btn.classList.toggle("is-playing", on);
      label.textContent = on ? btn.dataset.playing! : btn.dataset.label!;
      if (!on) {
        cancelAnimationFrame(raf);
        w.__voiceAmp = 0;
      }
    };
    const tick = () => {
      if (!analyser) return;
      const buf = new Uint8Array(analyser.fftSize);
      analyser.getByteTimeDomainData(buf);
      let sum = 0;
      for (let i = 0; i < buf.length; i++) {
        const v = (buf[i]! - 128) / 128;
        sum += v * v;
      }
      w.__voiceAmp = Math.min(1, Math.sqrt(sum / buf.length) * 4);
      raf = requestAnimationFrame(tick);
    };
    btn.addEventListener("click", async () => {
      if (!audio) {
        audio = new Audio(btn.dataset.src!);
        audio.preload = "auto";
        audio.addEventListener("ended", () => setPlaying(false));
        audio.addEventListener("pause", () => setPlaying(false));
        audio.addEventListener("play", () => setPlaying(true));
      }
      if (!audio.paused) {
        audio.pause();
        return;
      }
      try {
        if (!ctx) {
          ctx = new AudioContext();
          const src = ctx.createMediaElementSource(audio);
          analyser = ctx.createAnalyser();
          analyser.fftSize = 512;
          src.connect(analyser);
          analyser.connect(ctx.destination);
        }
        await ctx.resume();
      } catch {
        analyser = null;
      }
      await audio.play();
      if (analyser) tick();
    });
  }
</script>
