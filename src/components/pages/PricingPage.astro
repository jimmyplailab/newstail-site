---
/** Pris: en plan, räknaren, hur betalningen går till, allt som ingår och frågorna. */
import FaqList from "../FaqList.astro";
import { faqFor } from "../../content/faq";
import { ROUTES, START_URL, UI, type Lang } from "../../content/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
const ui = UI[lang];
const R = ROUTES[lang];
const faq = faqFor("pricing", lang);
const PRICE = sv ? 149 : 14;

const c = sv
  ? {
      h1: "149 kr per användare och månad.",
      lead: "Vi räknar bara de som faktiskt lyssnar. Den som inte lyssnar kostar inget.",
      plan: "Newstail",
      unit: "kr",
      per: "per lyssnare och månad",
      checks: ["Bara de som lyssnar räknas", "Minst 10 användare", "Ingen bindningstid", "Ni ser beloppet innan det dras"],
      cta: "Prova gratis i 14 dagar",
      fine: "Inget kort under provperioden. Priser exkl. moms. 14 € i övriga Europa, 15 $ i resten av världen.",
      calcKicker: "Räkna",
      calcTitle: "Vad kostar det för er?",
      emp: "Anställda",
      lis: "Lyssnar varje månad",
      month: "kr/mån",
      free: (n: number) => (n === 1 ? "1 som inte lyssnar kostar inget." : `${n} som inte lyssnar kostar inget.`),
      floor: "Minst tio användare debiteras.",
      dotScale: "En prick = fem personer",
      payKicker: "Betalningen",
      payTitle: "Ni vet beloppet innan det dras.",
      steps: [
        ["Dag 1", "Hela företaget gratis", "14 dagar. Inget kort."],
        ["Dag 15", "Lägg in kort", "Resten av månaden dras i förskott."],
        ["Den 1:a", "Räknat på månaden innan", "Mejl tre dagar innan."],
      ],
      exampleL: "Exempel",
      exampleV: "34 lyssnade i september → 5 066 kr den 1 oktober",
      inclTitle: "Allt ingår.",
      incl: ["Obegränsat lyssnande", "En egen sändning per medarbetare", "Fyra språk", "Publicera med röst eller text", "Team och publiceringsrätter", "Recap och quiz", "Fredagsmejlet", "Admin med insikter"],
      faqTitle: "Frågor om priset.",
      big: "Fler än 250? Prata med oss",
    }
  : {
      h1: "€14 per user and month.",
      lead: "We only count the people who actually listen. Anyone who doesn't listen costs nothing.",
      plan: "Newstail",
      unit: "€",
      per: "per listener and month",
      checks: ["Only listeners are counted", "At least 10 users", "No lock-in", "You see the amount before it's charged"],
      cta: "Try it free for 14 days",
      fine: "No card during the trial. Prices excl. VAT. SEK 149 in Sweden, $15 outside Europe.",
      calcKicker: "Calculate",
      calcTitle: "What does it cost for you?",
      emp: "Employees",
      lis: "Listen every month",
      month: "€/mo",
      free: (n: number) => (n === 1 ? "1 person who doesn't listen costs nothing." : `${n} people who don't listen cost nothing.`),
      floor: "At least ten users are charged.",
      dotScale: "One dot = five people",
      payKicker: "Payment",
      payTitle: "You know the amount before it's charged.",
      steps: [
        ["Day 1", "The whole company free", "14 days. No card."],
        ["Day 15", "Add a card", "The rest of the month is charged in advance."],
        ["The 1st", "Based on the month before", "Email three days ahead."],
      ],
      exampleL: "Example",
      exampleV: "34 listened in September → €476 on 1 October",
      inclTitle: "Everything included.",
      incl: ["Unlimited listening", "A broadcast for every employee", "Four languages", "Publish by voice or text", "Teams and publishing rights", "Recap and quiz", "The Friday email", "Admin with insights"],
      faqTitle: "Questions about pricing.",
      big: "More than 250? Talk to us",
    };
const E0 = 41;
const L0 = 34;
---

<section class="section sub-top" data-space data-hue="200" data-watch>
  <div class="split">
    <div class="split-text stack">
      <h1 class="title-hero">{c.h1}</h1>
      <p class="lead">{c.lead}</p>
    </div>
    <div class="split-stage stage-reach">
      <div class="plan">
        <span class="plan-name">{c.plan}</span>
        <span class="plan-price">
          {sv ? <b>{PRICE} kr</b> : <b>€{PRICE}</b>}
          <span>{c.per}</span>
        </span>
        <ul class="checks">{c.checks.map((x) => <li>{x}</li>)}</ul>
        <a class="pill pill-primary pill-lg" href={START_URL}>{c.cta}</a>
        <p class="plan-fine">{c.fine}</p>
      </div>
    </div>
  </div>
</section>

<section class="section" id={sv ? "rakna" : "calculate"} data-space data-hue="150" data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <p class="kicker">{c.calcKicker}</p>
      <h2 class="title-xl">{c.calcTitle}</h2>
    </div>
    <div class="calc" style="margin-top: 3rem" data-calc data-price={PRICE} data-lang={lang}>
      <div class="calc-controls">
        <label class="calc-row">
          <span>{c.emp}<output data-out="emp">{E0}</output></span>
          <input type="range" min="10" max="250" step="1" value={E0} data-in="emp" />
        </label>
        <label class="calc-row">
          <span>{c.lis}<output data-out="lis">{L0}</output></span>
          <input type="range" min="0" max={E0} step="1" value={L0} data-in="lis" />
        </label>
        <div class="calc-sum" aria-live="polite">
          <b><span data-out="sum">{sv ? `${(L0 * PRICE).toLocaleString("sv-SE")}` : `€${L0 * PRICE}`}</span><small>{c.month}</small></b>
          <span data-out="free">{c.free(E0 - L0)}</span>
          <em data-out="floor" hidden>{c.floor}</em>
        </div>
      </div>
      <div>
        <div class="calc-dots" data-dots aria-hidden="true"></div>
        <p class="note" data-out="scale" hidden style="text-align: right">{c.dotScale}</p>
      </div>
    </div>
  </div>
</section>

<section class="section" data-space data-hue="72" data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <p class="kicker">{c.payKicker}</p>
      <h2 class="title-xl">{c.payTitle}</h2>
    </div>
    <div class="timeline">
      {c.steps.map(([w, t, d], i) => (
        <div>
          <i class={i === 0 ? "on" : undefined} />
          <small>{w}</small>
          <b>{t}</b>
          <span>{d}</span>
        </div>
      ))}
    </div>
    <div class="example"><small>{c.exampleL}</small><span>{c.exampleV}</span></div>
  </div>
</section>

<section class="section" data-space data-hue="262" data-watch>
  <div class="wide">
    <div class="wide-head stack">
      <h2 class="title-xl">{c.inclTitle}</h2>
    </div>
    <div class="grid-4">
      {c.incl.map((x) => <div class="lined"><strong>{x}</strong></div>)}
    </div>
    <div class="actions">
      <a class="pill pill-primary pill-lg" href={START_URL}>{ui.startLong}</a>
    </div>
    <p class="note">{ui.noCard}</p>
  </div>
</section>

<section class="section" id={sv ? "fragor" : "questions"} data-space data-hue="200" data-watch>
  <div class="faq-split">
    <div class="stack">
      <h2 class="title-xl">{c.faqTitle}</h2>
      <a class="link-more" href={R.faq}>{ui.allQuestions}</a>
      <a class="link-more" href="mailto:hello@newstail.io" style="margin-top: 0.8rem">{c.big}</a>
    </div>
    <FaqList items={faq} lang={lang} />
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-calc]");
  if (root) {
    const price = Number(root.dataset.price);
    const sv = root.dataset.lang === "sv";
    const emp = root.querySelector<HTMLInputElement>('[data-in="emp"]')!;
    const lis = root.querySelector<HTMLInputElement>('[data-in="lis"]')!;
    const out = (k: string) => root.querySelector<HTMLElement>(`[data-out="${k}"]`)!;
    const dots = root.querySelector<HTMLElement>("[data-dots]")!;
    const freeText = (n: number) =>
      sv
        ? n === 1
          ? "1 som inte lyssnar kostar inget."
          : `${n} som inte lyssnar kostar inget.`
        : n === 1
          ? "1 person who doesn't listen costs nothing."
          : `${n} people who don't listen cost nothing.`;
    const render = () => {
      const e = Number(emp.value);
      lis.max = String(e);
      if (Number(lis.value) > e) lis.value = String(e);
      const l = Number(lis.value);
      const billed = Math.max(10, l);
      const sum = billed * price;
      out("emp").textContent = String(e);
      out("lis").textContent = String(l);
      out("sum").textContent = sv ? sum.toLocaleString("sv-SE") : `€${sum.toLocaleString("en-GB")}`;
      out("free").textContent = freeText(e - l);
      out("floor").hidden = l >= 10;
      const per = e > 60 ? 5 : 1;
      out("scale").hidden = per === 1;
      const n = Math.ceil(e / per);
      const lit = Math.round(l / per);
      if (dots.children.length !== n) dots.innerHTML = "<i></i>".repeat(n);
      Array.from(dots.children).forEach((d, i) => d.classList.toggle("on", i < lit));
    };
    emp.addEventListener("input", render);
    lis.addEventListener("input", render);
    render();
  }
</script>
