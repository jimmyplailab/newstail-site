---
/** Startsidan (2026-10-05, tavlan): varför – löftet, språket, sändningen, interninfo, recap, ledningen, frågor. */
import Phone from "../air/Phone.astro";
import ScreenPlayer from "../air/ScreenPlayer.astro";
import ScreenHome from "../air/ScreenHome.astro";
import ScreenPublish from "../air/ScreenPublish.astro";
import ScreenRecap from "../air/ScreenRecap.astro";
import AdminLaptop from "../air/AdminLaptop.astro";
import FaqList from "../FaqList.astro";
import { faqFor } from "../../content/faq";
import { ROUTES, START_URL, UI, type Lang } from "../../content/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
const ui = UI[lang];
const R = ROUTES[lang];
const words = (s: string) => s.split(" ");
const REST = "0.5,0.5,0.1,0";

const c = sv
  ? {
      h1: "En nyhetsvärd för varje medarbetare.",
      lead: "Nå de som aldrig öppnar intranätet. Och se att det kom fram.",
      chips: ["Internt", "Branschen", "Det man själv följer"],
      heroItems: [
        { topic: "INTERNT", title: "Hyresförhandlingen för 2027 är klar", inside: true },
        { topic: "RÄNTOR", title: "Ränteläget: marknaden räknar med sänkning före jul" },
        { topic: "HV71", title: "HV71 vände och vann borta i Linköping" },
      ],
      langTitle: "Alla hänger med. På sitt språk.",
      langLead: "Var och en väljer värdens språk. Samma nyheter, samma interna budskap.",
      langSamples: [
        { code: "SV", topic: "INTERNT", title: "Vi förvärvar två fastigheter i centrala Växjö" },
        { code: "EN", topic: "INTERNAL", title: "We are acquiring two properties in central Växjö" },
        { code: "DE", topic: "INTERN", title: "Wir erwerben zwei Immobilien im Zentrum von Växjö" },
        { code: "ES", topic: "INTERNO", title: "Adquirimos dos inmuebles en el centro de Växjö" },
      ],
      bcTitle: "Dra upp. Lyssna.",
      bcLead: "En egen sändning, byggd på din roll och det du följer.",
      bcPoints: ["Tre till tio minuter", "Håll klotet – värden berättar mer", "Varje dag något nytt utanför dina ämnen"],
      inTitle: "Säg det en gång. Vi läser upp det.",
      inLead: "Tala in eller skriv. Det ligger först i allas sändning – och ni ser hur många som hört det.",
      inTeams: ["Alla", "Förvaltning Jönköping", "Förvaltning Växjö"],
      inNote: "Bara de ni utser kan publicera. Missar någon det, kommer det i fredagsmejlet.",
      inFloat: "Vi förvärvar två fastigheter i centrala Växjö",
      inHeard: "har hört det",
      recTitle: "Gå djupare. Minns mer.",
      recLead: "Recap med källor, skicka vidare till en kollega och ett kort quiz.",
      leadTitle: "Se att det når fram.",
      leadLead: "Per team. Aldrig per person.",
      leadLink: "Vad ledningen ser",
      faqTitle: "Vanliga frågor.",
      endTitle: "Kom igång i dag.",
      endLead: "14 dagar gratis. Inget kort.",
      endPrice: "Se priser",
    }
  : {
      h1: "A news host for every employee.",
      lead: "Reach the people who never open the intranet. And see that it got through.",
      chips: ["Internal", "The industry", "What you follow"],
      heroItems: [
        { topic: "INTERNAL", title: "The 2027 rent negotiation is done", inside: true },
        { topic: "RATES", title: "Rates: the market expects a cut before Christmas" },
        { topic: "HOCKEY", title: "HV71 came back to win away in Linköping" },
      ],
      langTitle: "Everyone keeps up. In their language.",
      langLead: "Everyone picks the host's language. The same news, the same internal messages.",
      langSamples: [
        { code: "EN", topic: "INTERNAL", title: "We are acquiring two properties in central Växjö" },
        { code: "SV", topic: "INTERNT", title: "Vi förvärvar två fastigheter i centrala Växjö" },
        { code: "DE", topic: "INTERN", title: "Wir erwerben zwei Immobilien im Zentrum von Växjö" },
        { code: "ES", topic: "INTERNO", title: "Adquirimos dos inmuebles en el centro de Växjö" },
      ],
      bcTitle: "Pull up. Listen.",
      bcLead: "Your own broadcast, built on your role and what you follow.",
      bcPoints: ["Three to ten minutes", "Hold the orb – the host tells you more", "Something new every day, outside your topics"],
      inTitle: "Say it once. We read it out.",
      inLead: "Record or type it. It comes first in everyone's broadcast – and you see how many heard it.",
      inTeams: ["Everyone", "Property mgmt Jönköping", "Property mgmt Växjö"],
      inNote: "Only the people you choose can publish. Anyone who misses it gets it in the Friday email.",
      inFloat: "We are acquiring two properties in central Växjö",
      inHeard: "have heard it",
      recTitle: "Go deeper. Remember more.",
      recLead: "A recap with sources, send it on to a colleague, and a short quiz.",
      leadTitle: "See that it gets through.",
      leadLead: "Per team. Never per person.",
      leadLink: "What management sees",
      faqTitle: "Common questions.",
      endTitle: "Get started today.",
      endLead: "14 days free. No card.",
      endPrice: "See pricing",
    };

const player = sv
  ? [
      { topic: "INTERNT", title: "Hyresförhandlingen för 2027 är klar", src: "Anna Lindqvist", hue: 72 },
      { topic: "RÄNTOR", title: "Ränteläget: marknaden räknar med sänkning före jul", src: "3 källor", hue: 150 },
      { topic: "LOKALMARKNADEN", title: "Vakanserna minskar i Smålands kontorsmarknad", src: "2 källor", hue: 200 },
      { topic: "HV71", title: "HV71 vände och vann borta i Linköping", src: "1 källa", hue: 350 },
    ]
  : [
      { topic: "INTERNAL", title: "The 2027 rent negotiation is done", src: "Anna Lindqvist", hue: 72 },
      { topic: "RATES", title: "Rates: the market expects a cut before Christmas", src: "3 sources", hue: 150 },
      { topic: "OFFICE MARKET", title: "Fewer empty offices in Småland", src: "2 sources", hue: 200 },
      { topic: "HOCKEY", title: "HV71 came back to win in Linköping", src: "1 source", hue: 350 },
    ];
const homeItems = sv
  ? [
      { label: "Internt", kind: "inside" as const, title: "Hyresförhandlingen för 2027 är klar" },
      { label: "Räntor", kind: "industry" as const, title: "Sänkning före jul?" },
      { label: "Lokalmarknaden", kind: "industry" as const, title: "Vakanserna minskar i Småland" },
      { label: "HV71", kind: "own" as const, title: "Vände och vann i Linköping" },
    ]
  : [
      { label: "Internal", kind: "inside" as const, title: "The 2027 rent negotiation is done" },
      { label: "Rates", kind: "industry" as const, title: "A cut before Christmas?" },
      { label: "Office market", kind: "industry" as const, title: "Fewer empty offices" },
      { label: "Hockey", kind: "own" as const, title: "HV71 win in Linköping" },
    ];
const recap = sv
  ? {
      date: "Måndag 5 oktober",
      sub: "7 punkter · 6 min",
      send: "Skicka till kollega",
      share: "Dela",
      items: [
        { topic: "INTERNT", title: "Hyresförhandlingen för 2027 är klar", src: "Från Anna" },
        { topic: "RÄNTOR", title: "Ränteläget: marknaden räknar med sänkning före jul", src: "3 källor" },
        { topic: "LOKALMARKNADEN", title: "Vakanserna minskar i Smålands kontorsmarknad", src: "2 källor" },
      ],
      quiz: { kicker: "Quiz · 1 av 3", q: "Hur mycket höjs hyrorna i snitt?", options: ["2,4 %", "3,1 %", "4,0 %"], answer: 1 },
    }
  : {
      date: "Monday 5 October",
      sub: "7 stories · 6 min",
      send: "Send to colleague",
      share: "Share",
      items: [
        { topic: "INTERNAL", title: "The 2027 rent negotiation is done", src: "From Anna" },
        { topic: "RATES", title: "Rates: the market expects a cut before Christmas", src: "3 sources" },
        { topic: "OFFICE MARKET", title: "Fewer empty offices in Småland", src: "2 sources" },
      ],
      quiz: { kicker: "Quiz · 1 of 3", q: "How much do rents rise on average?", options: ["2.4 %", "3.1 %", "4.0 %"], answer: 1 },
    };
const publish = sv
  ? { head: "PUBLICERA", title: "Vad vill du berätta?", hint: "Tryck på klotet och berätta.", write: "Skriv istället", published: "Publicerat" }
  : { head: "PUBLISH", title: "What do you want to say?", hint: "Tap the orb and talk.", write: "Type instead", published: "Published" };
const faq = faqFor("home", lang);
---

<!-- 1. Hero -->
<section class="section hero" data-space data-hue="72" data-watch>
  <div class="split">
    <div class="split-text stack">
      <h1 class="title-hero">{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <div class="chips hero-chips" aria-hidden="true">
        <span class="chip chip-inside">{c.chips[0]}</span>
        <span class="chip chip-industry">{c.chips[1]}</span>
        <span class="chip chip-own">{c.chips[2]}</span>
      </div>
      <div class="actions">
        <a class="pill pill-primary pill-lg" href={START_URL}>{ui.start}</a>
        <button class="pill pill-secondary pill-lg" type="button" data-play-proxy>
          <svg width="11" height="11" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M3 1.5v9l7.5-4.5z"></path></svg>
          <span data-play-proxy-label>{ui.listen}</span>
        </button>
      </div>
    </div>
    <div class="split-stage stage-hero">
      <div class="orb-anchor" data-orb-anchor></div>
      <button class="orb-play play-sample" type="button" data-src={`/audio/sample-${lang}.mp3`} data-label={ui.listen} data-playing={ui.listening} aria-pressed="false" aria-label={ui.listen}>
        <span class="orb-play-circle"><span class="play-icon" aria-hidden="true"></span></span>
        <span class="play-label">{ui.listen}</span>
      </button>
      <div class="air-dots" aria-hidden="true">
        {c.heroItems.map((_, i) => <span class={i === 0 ? "is-on" : ""} />)}
      </div>
      <div class="caption caption-hero" style="--wait: 1500ms" aria-live="off">
        <span class="caption-topic" data-hero-topic>{c.heroItems[0]!.topic}</span>
        <span class="caption-title" data-hero-title>
          {words(c.heroItems[0]!.title).map((w, i) => (
            <><span class="caption-word" style={`--i: ${i}`}>{w}</span>{" "}</>
          ))}
        </span>
      </div>
      <script type="application/json" data-hero-items set:html={JSON.stringify(c.heroItems)} />
    </div>
  </div>
</section>

<!-- 2. Språket -->
<section class="section" id="sprak" data-space data-hue="262" data-watch>
  <div class="split orb-left lang-split">
    <div class="split-text stack">
      <div class="lang-chips">
        {c.langSamples.map((x, i) => (
          <button type="button" class={`lang-chip lang-chip-${i}${i === 0 ? " is-on" : ""}`} data-i={i} aria-label={x.code}>{x.code}</button>
        ))}
      </div>
      <h2 class="title-xl">{c.langTitle}</h2>
      <p class="lead">{c.langLead}</p>
    </div>
    <div class="split-stage stage-language">
      <div class="orb-anchor" data-orb-anchor></div>
      <div class="caption caption-language" style="--wait: 300ms" aria-live="off">
        <span class="caption-topic" data-lang-topic>{c.langSamples[0]!.topic}</span>
        <span class="caption-title" data-lang-title>
          {words(c.langSamples[0]!.title).map((w, i) => (
            <><span class="caption-word" style={`--i: ${i}`}>{w}</span>{" "}</>
          ))}
        </span>
      </div>
      <script type="application/json" data-lang-samples set:html={JSON.stringify(c.langSamples)} />
    </div>
  </div>
</section>

<!-- 3. Sändningen -->
<section class="section" id="sandningen" data-space data-hue="200" data-orb={REST} data-watch>
  <div class="split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.bcTitle}</h2>
      <p class="lead">{c.bcLead}</p>
      <ul class="dots-list">{c.bcPoints.map((p) => <li>{p}</li>)}</ul>
    </div>
    <div class="split-stage stage-device stage-glow" style="--glow-hue: 280">
      <Phone label={sv ? "Sändningen i Newstail-appen" : "The broadcast in the Newstail app"}>
        <ScreenPlayer items={player} start={1} done={sv ? "Avsluta" : "End"} />
      </Phone>
      <Phone back label={sv ? "Hemvyn i Newstail-appen" : "The Newstail home screen"}>
        <ScreenHome company="NORDVIK" greeting={sv ? "Hej Anna." : "Hi Anna."} date={sv ? "Måndag 5 oktober" : "Monday 5 October"} items={homeItems} />
      </Phone>
    </div>
  </div>
</section>

<!-- 4. Interninfo -->
<section class="section" id="inside" data-space data-hue="72" data-orb={REST} data-watch>
  <div class="split orb-left">
    <div class="split-text stack">
      <h2 class="title-xl">{c.inTitle}</h2>
      <p class="lead">{c.inLead}</p>
      <div class="chips" aria-hidden="true">
        {c.inTeams.map((t, i) => <span class={`chip${i === 0 ? " chip-on" : ""}`}>{t}</span>)}
      </div>
      <p class="note">{c.inNote}</p>
    </div>
    <div class="split-stage stage-device stage-glow" style="--glow-hue: 80">
      <Phone label={sv ? "Publicera i Newstail-appen" : "Publishing in the Newstail app"}>
        <ScreenPublish t={publish} />
      </Phone>
      <div class="floater hide-m" style="left: 0; top: 34%">{c.inFloat}</div>
      <div class="floater hide-m" style="right: 4%; bottom: 18%"><b>38 {sv ? "av" : "of"} 41</b><small>{c.inHeard}</small></div>
    </div>
  </div>
</section>

<!-- 5. Recap -->
<section class="section" id="recap" data-space data-hue="300" data-orb={REST} data-watch>
  <div class="split">
    <div class="split-text stack">
      <h2 class="title-xl">{c.recTitle}</h2>
      <p class="lead">{c.recLead}</p>
    </div>
    <div class="split-stage stage-device">
      <Phone label={sv ? "Recapen i Newstail-appen" : "The recap in the Newstail app"}>
        <ScreenRecap {...recap} />
      </Phone>
    </div>
  </div>
</section>

<!-- 6. Ledningen -->
<section class="section" id="ledare" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="split split-laptop">
    <div class="split-text stack">
      <h2 class="title-xl">{c.leadTitle}</h2>
      <p class="lead">{c.leadLead}</p>
      <a class="link-more" href={`${R.trust}${lang === "sv" ? "#ser" : "#sees"}`}>{c.leadLink}</a>
      <p class="note">{ui.demoNote}</p>
    </div>
    <div class="split-stage stage-device stage-laptop">
      <AdminLaptop lang={lang} />
    </div>
  </div>
</section>

<!-- 7. Frågor -->
<section class="section" id="fragor" data-space data-hue="262" data-orb={REST} data-watch>
  <div class="faq-split">
    <div class="stack">
      <h2 class="title-xl">{c.faqTitle}</h2>
      <a class="link-more" href={R.faq}>{ui.allQuestions}</a>
    </div>
    <FaqList items={faq} lang={lang} />
  </div>
</section>

<!-- 8. Avslut -->
<section class="section closing" data-space data-hue="200" data-orb="0.5,0.3,0.075,1" data-orb-m="0.5,0.28,0.12,1" data-watch>
  <div class="stack closing-text">
    <h2 class="title-xl">{c.endTitle}</h2>
    <p class="lead">{c.endLead}</p>
    <div class="actions">
      <a class="pill pill-primary pill-lg" href={START_URL}>{ui.start}</a>
      <a class="pill pill-secondary pill-lg" href={R.pricing}>{c.endPrice}</a>
    </div>
  </div>
</section>

<script>
  // Heron: rubrikerna byter som värden berättar dem (prickar, ämne + rubrik, klotets ton).
  const hero = document.querySelector<HTMLElement>(".hero");
  const heroItemsEl = hero?.querySelector<HTMLScriptElement>("[data-hero-items]");
  const swapWords = (el: HTMLElement, text: string) => {
    el.innerHTML = "";
    text.split(" ").forEach((word, j) => {
      const sp = document.createElement("span");
      sp.className = "caption-word";
      sp.style.setProperty("--i", String(j));
      sp.style.setProperty("--wait", "0ms");
      sp.textContent = word;
      el.append(sp, " ");
    });
  };
  const w = window as unknown as { __orbKick?: number; __voiceAmp: number };
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (hero && heroItemsEl) {
    const items = JSON.parse(heroItemsEl.textContent || "[]") as { topic: string; title: string; inside?: boolean }[];
    const HUES = [72, 150, 350];
    const topic = hero.querySelector<HTMLElement>("[data-hero-topic]")!;
    const title = hero.querySelector<HTMLElement>("[data-hero-title]")!;
    const dots = [...hero.querySelectorAll<HTMLElement>(".air-dots span")];
    let i = 0;
    let timer = 0;
    const show = (k: number) => {
      const x = items[k]!;
      topic.textContent = x.topic;
      swapWords(title, x.title);
      dots.forEach((d, j) => d.classList.toggle("is-on", j === k));
      hero.classList.toggle("is-inside", !!x.inside);
      hero.dataset.hue = String(HUES[k % HUES.length]);
      w.__orbKick = (w.__orbKick ?? 0) + 1;
    };
    const start = () => {
      if (timer || reduced) return;
      timer = window.setInterval(() => {
        i = (i + 1) % items.length;
        show(i);
      }, 3400);
    };
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    new IntersectionObserver(([e]) => (e!.isIntersecting ? start() : stop()), { threshold: 0.5 }).observe(hero);
  }

  // Språket: samma interna nyhet på värdens fyra språk; knapparna byter direkt.
  const langSec = document.getElementById("sprak");
  const samplesEl = langSec?.querySelector<HTMLScriptElement>("[data-lang-samples]");
  if (langSec && samplesEl) {
    const samples = JSON.parse(samplesEl.textContent || "[]") as { code: string; topic: string; title: string }[];
    const HUES = [262, 200, 30, 330];
    const topic = langSec.querySelector<HTMLElement>("[data-lang-topic]")!;
    const title = langSec.querySelector<HTMLElement>("[data-lang-title]")!;
    const chips = [...langSec.querySelectorAll<HTMLElement>(".lang-chip")];
    let i = 0;
    let timer = 0;
    const show = (k: number) => {
      const x = samples[k]!;
      topic.textContent = x.topic;
      swapWords(title, x.title);
      chips.forEach((c, j) => c.classList.toggle("is-on", j === k));
      langSec.dataset.hue = String(HUES[k % HUES.length]);
      w.__orbKick = (w.__orbKick ?? 0) + 1;
    };
    const start = () => {
      if (timer || reduced) return;
      timer = window.setInterval(() => {
        i = (i + 1) % samples.length;
        show(i);
      }, 2800);
    };
    const stop = () => {
      clearInterval(timer);
      timer = 0;
    };
    new IntersectionObserver(([e]) => (e!.isIntersecting ? start() : stop()), { threshold: 0.5 }).observe(langSec);
    chips.forEach((c, k) =>
      c.addEventListener("click", () => {
        stop();
        i = k;
        show(k);
      }),
    );
  }

  // "Lyssna 30 s": spelar röstprovet och skickar röstens styrka till klotet (window.__voiceAmp).
  const btn = document.querySelector<HTMLButtonElement>(".play-sample");
  const proxy = document.querySelector<HTMLButtonElement>("[data-play-proxy]");
  const proxyLabel = document.querySelector<HTMLElement>("[data-play-proxy-label]");
  if (btn) {
    let audio: HTMLAudioElement | null = null;
    let ctx: AudioContext | null = null;
    let analyser: AnalyserNode | null = null;
    let raf = 0;
    const label = btn.querySelector(".play-label")!;
    const setPlaying = (on: boolean) => {
      btn.setAttribute("aria-pressed", on ? "true" : "false");
      btn.classList.toggle("is-playing", on);
      label.textContent = on ? btn.dataset.playing! : btn.dataset.label!;
      if (proxyLabel) proxyLabel.textContent = on ? btn.dataset.playing! : btn.dataset.label!;
      if (!on) {
        cancelAnimationFrame(raf);
        w.__voiceAmp = 0;
      }
    };
    const tick = () => {
      if (!analyser) return;
      const buf = new Uint8Array(analyser.fftSize);
      analyser.getByteTimeDomainData(buf);
      let sum = 0;
      for (let k = 0; k < buf.length; k++) {
        const v = (buf[k]! - 128) / 128;
        sum += v * v;
      }
      w.__voiceAmp = Math.min(1, Math.sqrt(sum / buf.length) * 4);
      raf = requestAnimationFrame(tick);
    };
    const toggle = async () => {
      if (!audio) {
        audio = new Audio(btn.dataset.src!);
        audio.preload = "auto";
        audio.addEventListener("ended", () => setPlaying(false));
        audio.addEventListener("pause", () => setPlaying(false));
        audio.addEventListener("play", () => setPlaying(true));
      }
      if (!audio.paused) {
        audio.pause();
        return;
      }
      try {
        if (!ctx) {
          ctx = new AudioContext();
          const src = ctx.createMediaElementSource(audio);
          analyser = ctx.createAnalyser();
          analyser.fftSize = 512;
          src.connect(analyser);
          analyser.connect(ctx.destination);
        }
        await ctx.resume();
      } catch {
        analyser = null;
      }
      await audio.play();
      if (analyser) tick();
    };
    btn.addEventListener("click", toggle);
    proxy?.addEventListener("click", () => {
      document.querySelector(".hero")?.scrollIntoView({ behavior: "smooth" });
      toggle();
    });
  }
</script>
