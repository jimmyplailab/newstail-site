---
/** /fragor: sök, kategorier och alla frågor ihopfällda. Varje fråga har en egen sida. */
import { CATS, FAQ, faqPath, type FaqCat } from "../../content/faq";
import { type Lang } from "../../content/site";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sv = lang === "sv";
const cats = Object.keys(CATS) as FaqCat[];
const groups = cats.map((k) => ({ k, name: CATS[k][lang], items: FAQ.filter((f) => f.cat === k) })).filter((g) => g.items.length);
---

<div class="page" data-space data-hue="262">
  <header class="page-head">
    <h1 class="title-hero">{sv ? "Frågor och svar." : "Questions and answers."}</h1>
  </header>
  <div class="faq-tools">
    <label class="search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" style="color: var(--ink-2)"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-4-4"></path></svg>
      <span class="sr-only">{sv ? "Sök bland frågorna" : "Search the questions"}</span>
      <input type="search" data-faq-search placeholder={sv ? "Sök, till exempel ”pris” eller ”språk”" : "Search, for example “price” or “language”"} />
    </label>
    <div class="cats" role="group" aria-label={sv ? "Kategorier" : "Categories"}>
      <button type="button" aria-pressed="true" data-cat="all">{sv ? "Alla" : "All"}</button>
      {groups.map((g) => <button type="button" aria-pressed="false" data-cat={g.k}>{g.name}</button>)}
    </div>
  </div>
  {
    groups.map((g) => (
      <section class="faq-group" id={g.k} data-group={g.k}>
        <h2>{g.name}</h2>
        <div class="faq">
          {g.items.map((f) => (
            <details data-q={`${f[lang].q} ${f[lang].a}`.toLowerCase()}>
              <summary>{f[lang].q}</summary>
              <div class="faq-a">
                <p>{f[lang].a}</p>
                <a href={faqPath(lang, f.slug[lang])}>{sv ? "Egen sida ›" : "Own page ›"}</a>
              </div>
            </details>
          ))}
        </div>
      </section>
    ))
  }
  <p class="faq-empty" data-faq-empty hidden>
    {sv ? "Inget svar på det än. Mejla " : "No answer to that yet. Email "}<a href="mailto:hello@newstail.io">hello@newstail.io</a>.
  </p>
</div>

<script>
  const input = document.querySelector<HTMLInputElement>("[data-faq-search]");
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-cat]"));
  const groups = Array.from(document.querySelectorAll<HTMLElement>("[data-group]"));
  const empty = document.querySelector<HTMLElement>("[data-faq-empty]");
  let cat = "all";
  const apply = () => {
    const q = (input?.value ?? "").trim().toLowerCase();
    let shown = 0;
    for (const g of groups) {
      const inCat = cat === "all" || g.dataset.group === cat;
      let any = false;
      g.querySelectorAll<HTMLDetailsElement>("details").forEach((d) => {
        const hit = inCat && (!q || (d.dataset.q ?? "").includes(q));
        d.hidden = !hit;
        if (hit) any = true;
        if (q && hit) d.open = true;
      });
      g.hidden = !any;
      if (any) shown++;
    }
    if (empty) empty.hidden = shown > 0;
  };
  buttons.forEach((b) =>
    b.addEventListener("click", () => {
      cat = b.dataset.cat ?? "all";
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      apply();
    }),
  );
  input?.addEventListener("input", apply);
  const hash = location.hash.slice(1);
  const pre = buttons.find((b) => b.dataset.cat === hash);
  if (pre) pre.click();
</script>
