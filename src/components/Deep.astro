---
/** Fördjupningssida (Produkten, För företag): hero med klotet, sektioner som växlar sida. */
import type { Copy } from "../i18n/types";
import { START_URL } from "../i18n/types";
import type { DeepPage } from "../i18n/pages";

interface Props {
  copy: Copy;
  page: DeepPage;
}
const { copy: c, page } = Astro.props;
const REST = "0.5,0.5,0.1,0";
const pricing = c.lang === "sv" ? "/pris/" : "/en/pricing/";
const alt = {
  "phone-home": c.lang === "sv" ? "Newstail-appens hemvy med dagens rubriker" : "The Newstail app home screen with today's headlines",
  "phone-publish": c.lang === "sv" ? "Publicera i Newstail-appen" : "Publishing in the Newstail app",
  admin: c.lang === "sv" ? "Admin i Newstail: översikt" : "Newstail admin: overview",
};
---

<section class="section deep-hero" data-space data-hue="262" data-orb="0.78,0.52,0.19,1" data-orb-m="0.5,0.3,0.2,1" data-watch>
  <div class="split">
    <div class="split-text stack">
      <h1 class="title-hero">{page.title}</h1>
      <p class="lead">{page.lead}</p>
      <div class="actions">
        <a class="pill pill-primary pill-lg" href={START_URL}>{c.hero.cta}</a>
      </div>
    </div>
    <div class="split-stage deep-hero-stage"></div>
  </div>
</section>

{
  page.sections.map((s, n) => {
    const flip = n % 2 === 1;
    const hasOrb = s.visual === "orb";
    return (
      <section
        class="section section-auto deep"
        id={s.id}
        data-space
        data-hue={String(s.hue)}
        data-orb={hasOrb ? undefined : REST}
        data-watch
      >
        <div class={`split${flip ? " orb-left" : ""}${s.visual === "none" || s.visual === "flow" ? " split-wide" : ""}`}>
          <div class="split-text stack">
            <h2 class="title-xl">{s.title}</h2>
            <p class="lead">{s.lead}</p>
            {s.points && (
              <ul class="deep-points">
                {s.points.map((p, i) => (
                  <li class="reveal" style={`--i: ${i + 1}`}>
                    <strong>{p.t}</strong>
                    {p.d && <span>{p.d}</span>}
                  </li>
                ))}
              </ul>
            )}
          </div>
          {s.visual === "flow" && s.flow && (
            <ol class="flow">
              {s.flow.map((f, i) => (
                <li class="reveal" style={`--i: ${i + 1}`}>
                  <span class="flow-dot" aria-hidden="true" />
                  <strong>{f.t}</strong>
                  <p>{f.d}</p>
                </li>
              ))}
            </ol>
          )}
          {s.visual === "orb" && (
            <div class="split-stage stage-deep-orb">
              <div class="orb-anchor" data-orb-anchor />
            </div>
          )}
          {(s.visual === "phone-home" || s.visual === "phone-publish") && (
            <div class="split-stage phone-stage reveal" style="--i: 1">
              <div class="phone">
                <img src={`/screens/${s.visual === "phone-home" ? "app-home" : "app-publish"}.webp`} alt={alt[s.visual]} width="720" height="1565" loading="lazy" decoding="async" />
              </div>
            </div>
          )}
          {s.visual === "admin" && (
            <div class="split-stage stage-admin reveal" style="--i: 1">
              <div class="screen screen-admin">
                <img src="/screens/admin-overview.webp" alt={alt.admin} width="1400" height="1242" loading="lazy" decoding="async" />
              </div>
            </div>
          )}
        </div>
      </section>
    );
  })
}

<section class="section closing deep-closing" data-space data-hue="262" data-watch>
  <div class="orb-anchor orb-anchor-closing" data-orb-anchor></div>
  <div class="stack closing-text">
    <h2 class="title-xl">{page.ctaTitle}</h2>
    <p class="lead">{page.ctaLead}</p>
    <div class="actions">
      <a class="pill pill-primary pill-lg" href={START_URL}>{c.closing.cta}</a>
      <a class="pill pill-secondary pill-lg" href={pricing}>{c.closing.priceLink}</a>
    </div>
  </div>
</section>
