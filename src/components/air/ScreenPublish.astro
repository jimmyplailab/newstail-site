---
/** Publicera: "Vad vill du berätta?", det guldiga klotet (den egna rösten), Skriv istället. */
interface Props {
  t: { head: string; title: string; hint: string; write: string; published: string };
}
const { t } = Astro.props;
---

<div class="scr-publish">
  <div class="scr-head">
    <span class="scr-round" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#eceff4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg></span>
    <span class="scr-company">{t.head}</span>
    <span class="scr-round" aria-hidden="true">?</span>
  </div>
  <span class="scr-hello scr-hello-pub">{t.title}</span>
  <img class="scr-pub-orb" src="/orbs/orb-72.webp" alt="" width="240" height="240" loading="lazy" decoding="async" />
  <span class="scr-pub-hint">{t.hint}</span>
  <span class="scr-pill scr-pill-pub">{t.write}</span>
  <span class="scr-pub-foot"><span>{t.published}</span><span>12 ›</span></span>
</div>
