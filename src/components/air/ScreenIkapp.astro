---
/**
 * "Du är ikapp": klotet krymper till en stjärna och flyger till dagens plats i veckans himmel,
 * stjärnan blixtrar, texten och Recap/Quiz kommer fram. Spelas när telefonen syns och med
 * knappen [data-ikapp-replay] i samma sektion.
 */
interface Props {
  t: { before: string; done: string; streak: string; recap: string; quiz: string };
}
const { t } = Astro.props;
const lit = [
  [70, 190],
  [105, 150],
  [128, 182],
];
const today = [150, 150];
const rest = [
  [192, 128],
  [224, 160],
  [262, 140],
];
const far = [
  [60, 92], [74, 84], [86, 96], [250, 88], [264, 98], [300, 76],
];
---

<div class="scr-ikapp" data-ikapp>
  {far.map(([x, y]) => <span class="ik-far" style={`left:${x}px;top:${y}px`} />)}
  {lit.map(([x, y]) => <span class="ik-star is-lit" style={`left:${x}px;top:${y}px`} />)}
  <span class="ik-star ik-today" style={`left:${today[0]}px;top:${today[1]}px`}></span>
  {rest.map(([x, y]) => <span class="ik-star" style={`left:${x}px;top:${y}px`} />)}
  <img class="ik-orb" src="/orbs/orb-300.webp" alt="" width="240" height="240" loading="lazy" decoding="async" />
  <span class="ik-before">{t.before}</span>
  <span class="ik-done"><strong>{t.done}</strong><small>{t.streak}</small></span>
  <span class="ik-pills"><span>{t.recap}</span><span>{t.quiz}</span></span>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-ikapp]").forEach((el) => {
    const play = () => {
      el.classList.remove("is-playing");
      void el.offsetWidth;
      el.classList.add("is-playing");
    };
    let played = false;
    new IntersectionObserver(([e]) => {
      if (e!.isIntersecting && !played) {
        played = true;
        window.setTimeout(play, 600);
      }
    }, { threshold: 0.6 }).observe(el);
    el.closest("section")?.querySelector("[data-ikapp-replay]")?.addEventListener("click", play);
  });
</script>
