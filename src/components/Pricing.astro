---
/**
 * Prissidan i SaaS-struktur (Joel 2026-09-30, "strukturen, inte visuellt"):
 * 1) rubrik + månad/år + en plan, 2) räknare, 3) allt ingår, 4) frågor + sidfot.
 * Siffrorna kommer från src/i18n/pricing.ts (samma pris som appens billing_prices).
 */
import type { Copy } from "../i18n/types";
import { START_URL } from "../i18n/types";
import { pricing, YEAR_FACTOR } from "../i18n/pricing";
import LineArt from "./LineArt.astro";

interface Props {
  copy: Copy;
}
const { copy: c } = Astro.props;
const p = pricing[c.lang as "sv" | "en"];
const sv = c.lang === "sv";
const year = (n: number) => n * YEAR_FACTOR;
const first = p.plan.price;
---

<section class="section price-hero" id="pris" data-space data-hue="150" data-watch>
  <div class="price-top">
    <div class="price-head">
      <h1 class="title-xl">{p.title}</h1>
      <p class="lead">{p.lead}</p>
      <div class="billing-toggle" role="group" aria-label={sv ? "Betalningsperiod" : "Billing period"}>
        <button type="button" data-billing="m" aria-pressed="true">{p.monthly}</button>
        <button type="button" data-billing="y" aria-pressed="false">{p.yearly}<span class="billing-badge">{p.yearlyBadge}</span></button>
      </div>
    </div>

    <article class="plan">
      <h2 class="plan-name">{p.plan.name}</h2>
      <p class="plan-price">
        {p.plan.unitBefore && <span class="plan-cur">{p.plan.unitBefore}</span>}
        <span class="plan-amount px" data-m={String(first)} data-y={sv ? String(Math.round(year(first))) : year(first).toFixed(2)}>{first}</span>
        {p.plan.unitAfter && <span class="plan-cur">{p.plan.unitAfter}</span>}
      </p>
      <p class="plan-unit">
        <span data-show="m">{p.perUnit}</span>
        <span data-show="y" hidden>{p.perUnitYear}</span>
      </p>
      <ul class="plan-features">
        {p.plan.features.map((f) => <li>{f}</li>)}
      </ul>
      <a class="pill pill-lg pill-primary" href={START_URL}>{p.plan.cta}</a>
      <p class="plan-trial">{p.plan.trial} {p.vatNote}</p>
    </article>
  </div>
</section>

<section class="section price-calc" id="rakna" data-space data-hue="170" data-watch>
  <div class="calc">
    <div class="calc-side">
      <h2 class="title-xl">{p.calc.title}</h2>
      <p class="lead">{p.calc.lead}</p>
    </div>
    <div class="calc-card" data-calc>
      <div class="calc-label">
        <label for="calc-seats">{p.calc.label}</label>
        <output for="calc-seats" class="calc-seats-out">30</output>
      </div>
      <input id="calc-seats" class="calc-range" type="range" min="1" max="500" step="1" value="30" />
      <div class="calc-total">
        <span class="calc-amount">–</span>
        <span class="calc-per">{p.calc.perMonth}</span>
      </div>
      <p class="calc-year"><span class="calc-year-amount">–</span> {p.calc.perYear}</p>
      <ul class="calc-rows" aria-label={p.calc.breakdown}></ul>
      <p class="calc-floor" hidden>{p.calc.floorNote}</p>
      <div class="billing-toggle billing-toggle-sm" role="group" aria-label={sv ? "Betalningsperiod" : "Billing period"}>
        <button type="button" data-billing="m" aria-pressed="true">{p.monthly}</button>
        <button type="button" data-billing="y" aria-pressed="false">{p.yearly}<span class="billing-badge">{p.yearlyBadge}</span></button>
      </div>
    </div>
  </div>
</section>

<section class="section price-included" id="ingar" data-space data-hue="200" data-watch>
  <div class="included included-grid">
    <div class="included-side">
      <h2 class="title-xl">{p.included.title}</h2>
      <LineArt kind="cube" />
    </div>
    <div>
      <ul class="check-list included-list">
        {p.included.items.map((x, i) => <li class="reveal" style={`--i: ${i}`}>{x}</li>)}
      </ul>
      <div class="actions">
        <a class="pill pill-primary pill-lg" href={START_URL}>{p.plan.cta}</a>
      </div>
    </div>
  </div>
</section>

<section class="section price-faq" id="fragor" data-space data-hue="262" data-watch>
  <div class="faq-wrap">
    <h2 class="title-xl">{p.faq.title}</h2>
    <div class="faq">
      {
        p.faq.items.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: p.faq.items.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  })}
/>

<script define:vars={{ lang: c.lang, label: p.calc.rowLabel }}>
  window.__priceLang = lang;
  window.__priceRowLabel = label;
</script>

<script>
  import { PRICES, MIN_SEATS, YEAR_FACTOR } from "../i18n/pricing";

  const w = window as unknown as { __priceLang: string; __priceRowLabel: string };
  const sv = w.__priceLang === "sv";
  const price = sv ? PRICES.SEK : PRICES.EUR;
  const money = (n: number) =>
    sv
      ? `${Math.round(n).toLocaleString("sv-SE")} kr`
      : `€${n.toLocaleString("en-GB", { maximumFractionDigits: n < 100 ? 2 : 0 })}`;
  let billing: "m" | "y" = "m";

  /** Rakt pris som i appens billing_quote(): pris × max(aktiva, golv). */
  const breakdown = (seats: number) => {
    const billed = Math.max(seats, MIN_SEATS);
    const rows = [{ label: w.__priceRowLabel, n: billed, price }];
    return { billed, rows, total: billed * price };
  };

  const range = document.querySelector<HTMLInputElement>(".calc-range");
  const out = document.querySelector<HTMLOutputElement>(".calc-seats-out");
  const amount = document.querySelector<HTMLElement>(".calc-amount");
  const yearAmount = document.querySelector<HTMLElement>(".calc-year-amount");
  const rowsEl = document.querySelector<HTMLUListElement>(".calc-rows");
  const floor = document.querySelector<HTMLElement>(".calc-floor");

  const renderCalc = () => {
    if (!range) return;
    const seats = Number(range.value);
    const f = billing === "y" ? YEAR_FACTOR : 1;
    const { billed, rows, total } = breakdown(seats);
    if (out) out.textContent = String(seats);
    if (amount) amount.textContent = money(total * f);
    if (yearAmount) yearAmount.textContent = money(total * f * 12);
    if (floor) floor.hidden = seats >= billed;
    if (rowsEl) {
      rowsEl.innerHTML = rows
        .map(
          (r) =>
            `<li><span>${r.label}</span><span>${r.n} × ${money(r.price * f)}</span><span>${money(r.n * r.price * f)}</span></li>`,
        )
        .join("");
    }
    range.style.setProperty("--fill", `${((seats - 1) / (Number(range.max) - 1)) * 100}%`);
  };

  const setBilling = (b: "m" | "y") => {
    billing = b;
    document.querySelectorAll<HTMLButtonElement>("[data-billing]").forEach((btn) => {
      btn.setAttribute("aria-pressed", String(btn.dataset.billing === b));
    });
    document.querySelectorAll<HTMLElement>(".px").forEach((el) => {
      el.textContent = (b === "y" ? el.dataset.y : el.dataset.m) ?? el.textContent;
    });
    document.querySelectorAll<HTMLElement>("[data-show]").forEach((el) => {
      el.hidden = el.dataset.show !== b;
    });
    renderCalc();
  };

  document.querySelectorAll<HTMLButtonElement>("[data-billing]").forEach((btn) => {
    btn.addEventListener("click", () => setBilling(btn.dataset.billing as "m" | "y"));
  });
  range?.addEventListener("input", renderCalc);
  renderCalc();

</script>
