---
import "@fontsource-variable/inter";
import "../styles/global.css";
import Space from "../space/Space";
import type { Copy } from "../i18n/types";
import { LOGIN_URL, START_URL } from "../i18n/types";

interface Props {
  copy: Copy;
  /** Sidans sökväg på det här språket, t.ex. "/" eller "/pris/". */
  path: string;
  /** Samma sida på det andra språket. */
  altPath: string;
  title: string;
  description: string;
  /** Sektionerna snäpper (bara startsidan). */
  snap?: boolean;
  /** Klotet i rymden (bara startsidan – undersidorna har bara stjärnorna). */
  orb?: boolean;
}
const { copy, path, altPath, title, description, snap = false, orb = true } = Astro.props;
const site = "https://newstail.io";
const canonical = `${site}${path}`;
const svPath = copy.lang === "sv" ? path : altPath;
const enPath = copy.lang === "en" ? path : altPath;
const home = copy.lang === "sv" ? "/" : "/en/";
const pricing = copy.lang === "sv" ? "/pris/" : "/en/pricing/";
const techPage = copy.lang === "sv" ? "/tekniken/" : "/en/technology/";
const trustPage = copy.lang === "sv" ? "/trygghet/" : "/en/trust/";
---

<!doctype html>
<html lang={copy.htmlLang} class={snap ? "snap" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="sv" href={`${site}${svPath}`} />
    <link rel="alternate" hreflang="en" href={`${site}${enPath}`} />
    <link rel="alternate" hreflang="x-default" href={`${site}${svPath}`} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Newstail" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:locale" content={copy.lang === "sv" ? "sv_SE" : "en_GB"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}/og.png`} />
    <slot name="head" />
  </head>
  <body>
    <Space client:load orb={orb} />
    <header class="nav" id="nav">
      <div class="nav-inner">
        <a href={home} class="logo" aria-label="Newstail"></a>
        <nav class="nav-links" aria-label="Meny">
          <a href={techPage} aria-current={path === techPage ? "page" : undefined}>{copy.nav.tech}</a>
          <a href={trustPage} aria-current={path === trustPage ? "page" : undefined}>{copy.nav.trust}</a>
          <a href={pricing} aria-current={path === pricing ? "page" : undefined}>{copy.nav.pricing}</a>
        </nav>
        <div class="nav-right">
          <a class="lang" href={altPath} hreflang={copy.lang === "sv" ? "en" : "sv"}>{copy.nav.switch}</a>
          <a class="pill pill-ghost nav-login" href={LOGIN_URL}>{copy.nav.login}</a>
          <a class="pill pill-primary nav-start" href={START_URL}>{copy.nav.start}</a>
          <button class="nav-menu-btn" type="button" aria-expanded="false" aria-controls="nav-sheet" aria-label={copy.lang === "sv" ? "Meny" : "Menu"}>
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
      <nav class="nav-sheet" id="nav-sheet" aria-label={copy.lang === "sv" ? "Meny" : "Menu"} hidden>
        <a href={techPage}>{copy.nav.tech}</a>
        <a href={trustPage}>{copy.nav.trust}</a>
        <a href={pricing}>{copy.nav.pricing}</a>
        <a href={LOGIN_URL}>{copy.nav.login}</a>
        <div class="nav-sheet-foot">
          <a class="pill pill-primary pill-lg" href={START_URL}>{copy.nav.start}</a>
          <a class="nav-sheet-lang" href={altPath} hreflang={copy.lang === "sv" ? "en" : "sv"}>{copy.lang === "sv" ? "English" : "Svenska"}</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <span class="logo" aria-hidden="true"></span>
        <span>{copy.footer.line}</span>
        <span class="footer-spacer"></span>
        <a href={techPage}>{copy.nav.tech}</a>
        <a href={trustPage}>{copy.nav.trust}</a>
        <a href={pricing}>{copy.nav.pricing}</a>
        <a href={LOGIN_URL}>{copy.nav.login}</a>
        <a href={`mailto:${copy.footer.contact}`}>{copy.footer.contact}</a>
        <a href={altPath}>{copy.nav.switch}</a>
      </div>
    </footer>
    <script>
      // Topplinjen blir glas när man scrollat; sektionernas animationer startar när de syns.
      // Omladdning börjar alltid högst upp (webbläsaren ska inte återställa scrollen).
      if ("scrollRestoration" in history) history.scrollRestoration = "manual";
      if (!location.hash) window.scrollTo(0, 0);
      const nav = document.getElementById("nav");
      const menuBtn = document.querySelector<HTMLButtonElement>(".nav-menu-btn");
      const sheet = document.getElementById("nav-sheet");
      menuBtn?.addEventListener("click", () => {
        const open = menuBtn.getAttribute("aria-expanded") !== "true";
        menuBtn.setAttribute("aria-expanded", String(open));
        if (sheet) sheet.hidden = !open;
        nav?.classList.toggle("menu-open", open);
      });
      const onScroll = () => nav?.classList.toggle("is-scrolled", window.scrollY > 24);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add("in-view");
              io.unobserve(e.target);
            }
          }
        },
        { threshold: 0.35 },
      );
      document.querySelectorAll("[data-watch]").forEach((el) => io.observe(el));
      // Sista sektionen + sidfoten ryms på en skärm: sektionen krymper med sidfotens höjd.
      const footer = document.querySelector<HTMLElement>(".footer");
      if (footer) {
        const setFooter = () =>
          document.documentElement.style.setProperty("--footer-h", `${Math.ceil(footer.getBoundingClientRect().height)}px`);
        setFooter();
        new ResizeObserver(setFooter).observe(footer);
      }
    </script>
  </body>
</html>
