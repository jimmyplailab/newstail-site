---
import Base from "../../layouts/Base.astro";
import PricingPage from "../../components/pages/PricingPage.astro";
import { breadcrumbs, faqPage } from "../../content/site";
import { faqFor } from "../../content/faq";
---

<Base
  lang="en"
  path="/en/pricing/"
  altPath="/pris/"
  title="Pricing – €14 per user who listens | Newstail"
  description="One price: €14 per user and month, and only people who actually listen are counted. At least ten users, no lock-in, 14 days free."
  snap
  schema={[breadcrumbs([{ name: "Newstail", path: "/en/" }, { name: "Pricing", path: "/en/pricing/" }]), faqPage(faqFor("pricing", "en"))]}
>
  <PricingPage lang="en" />
</Base>
