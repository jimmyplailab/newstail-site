---
import Base from "../../layouts/Base.astro";
import Deep from "../../components/Deep.astro";
import { en as copy } from "../../i18n/en";
import { product } from "../../i18n/pages";
const page = product.en;
---

<Base copy={copy} path="/en/product/" altPath="/produkt/" title={page.metaTitle} description={page.metaDescription}>
  <Deep copy={copy} page={page} />
</Base>
