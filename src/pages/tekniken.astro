---
import Base from "../layouts/Base.astro";
import Tech from "../components/Tech.astro";
import { sv as copy } from "../i18n/sv";
import { tech } from "../i18n/subpages";
const page = tech.sv;
---

<Base copy={copy} path="/tekniken/" altPath="/en/technology/" title={page.metaTitle} description={page.metaDescription} orb={false} snap>
  <Tech page={page} cta={copy.hero.cta} />
</Base>
