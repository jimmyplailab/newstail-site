---
import Base from "../layouts/Base.astro";
import DocPage from "../components/pages/DocPage.astro";
import { LEGAL } from "../content/legal";
import { breadcrumbs } from "../content/site";
const doc = LEGAL.privacy.sv;
---

<Base
  lang="sv"
  path="/integritet/"
  altPath="/en/privacy/"
  title={doc.metaTitle}
  description={doc.metaDescription}
  schema={[breadcrumbs([{ name: "Newstail", path: "/" }, { name: "Trygghet", path: "/trygghet/" }, { name: doc.title, path: "/integritet/" }])]}
>
  <DocPage lang="sv" doc={doc} />
</Base>
