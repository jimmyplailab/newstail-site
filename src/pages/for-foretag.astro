---
import Base from "../layouts/Base.astro";
import Deep from "../components/Deep.astro";
import { sv as copy } from "../i18n/sv";
import { companies } from "../i18n/pages";
const page = companies.sv;
---

<Base copy={copy} path="/for-foretag/" altPath="/en/for-companies/" title={page.metaTitle} description={page.metaDescription}>
  <Deep copy={copy} page={page} />
</Base>
